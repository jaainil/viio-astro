---
import shreeLogo from "../assets/shree-cretex.png";
import type { Link } from "../types";

interface Props {
  logoUrl: string;
  logoAlt: string;
  links: Link[];
}

const { logoUrl, logoAlt, links } = Astro.props;
---

<sy-footer>
  <footer>
    <div class="footer-decoration"></div>
    <div class="inner u-container">
      <div class="wrapper">
        <div class="footer-brand">
          <a class="logo" href={logoUrl}>
            <img src={shreeLogo.src} alt={logoAlt} />
            <span class="u-sr-only">{logoAlt}</span>
          </a>
          <p class="footer-tagline">Professional Social Media Marketing & Content Creation</p>
        </div>

        <div class="menu">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.url}>{l.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
        
        <div class="footer-contact">
          <a href="tel:+918980041504" class="contact-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            +91 8980041504
          </a>
          <a href="mailto:shreecreatixagency@gmail.com" class="contact-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            shreecreatixagency@gmail.com
          </a>
        </div>

        <div class="footer-social">
          <a href="https://www.instagram.com/vinit_tank_3110_" class="social-icon" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://wa.me/+918980041504" class="social-icon" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </a>
        </div>
        
        <div class="footer-bottom">
          <p class="cp">© {new Date().getFullYear()} {logoAlt}. All rights reserved.</p>
          <p class="powered-by">Powered by <a href="https://aexaware.com?utm_source=website&utm_medium=referral&utm_campaign=powered_by" target="_blank" rel="noopener noreferrer">Aexaware Infotech Pvt. Ltd.</a></p>
        </div>
      </div>
    </div>
  </footer>
</sy-footer>

<style>
  sy-footer {
    @extend %u-text;

    --fs: var(--font-size-sm);
    display: block;
    clip-path: inset(0);

    :global(&.has-no-anim footer) {
      position: static;
    }
  }

  footer {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #1f2023 100%);
    color: rgba(255, 255, 255, 0.8);
    position: relative;
    width: 100%;
    padding: 5rem 0 3rem;
    margin-top: 4rem;
    overflow: hidden;
  }

  .footer-decoration {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-brand-1), var(--color-brand-2), var(--color-brand-1));
  }

  .inner {
    padding: 0;
  }

  .footer-brand {
    margin-bottom: 2rem;
    text-align: center;
  }

  .logo {
    position: relative;
    z-index: 3;
    display: inline-block;

    img {
      height: 5rem;
      width: auto;
      transition: transform 0.3s var(--ease-out-cubic);
    }

    &:hover img {
      transform: scale(1.05);
    }
  }

  .footer-tagline {
    margin-top: 0.75rem;
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .menu {
    margin-bottom: 2rem;
    
    ul {
      display: flex;
      padding: 0;
      gap: 2rem;
      margin: 0;
      list-style: none;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;

      a {
        text-decoration: none;
        position: relative;
        font-size: var(--font-size-sm);
        transition: color 0.2s;
        color: rgba(255, 255, 255, 0.8);

        &::after {
          content: "";
          position: absolute;
          height: 2px;
          background: var(--color-brand-1);
          top: 115%;
          width: 100%;
          left: 0;
          pointer-events: none;
          transform: scaleX(0);
          transition: transform 0.3s var(--ease-out-expo);
          transform-origin: right;
        }

        &:hover,
        &:focus {
          color: var(--color-white);
          &::after {
            transform: scaleX(1);
            transform-origin: left;
          }
        }
      }
    }
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color 0.2s;

    svg {
      opacity: 0.7;
    }

    &:hover {
      color: var(--color-white);
      svg {
        opacity: 1;
      }
    }
  }

  .footer-social {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .social-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    transition: all 0.3s var(--ease-out-cubic);

    &:hover {
      background: var(--color-brand-1);
      color: var(--color-white);
      transform: translateY(-3px);
    }
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    width: 100%;
  }

  .cp {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .powered-by {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.5);
    margin: 0;

    a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: color 0.2s;

      &:hover {
        color: var(--color-brand-1);
      }
    }
  }
</style>
